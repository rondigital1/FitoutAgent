{
  "manifest_version": 3,
  "name": "FitoutAgent",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "description": "Multi-item shopping side panel. No payment.",
  "permissions": ["sidePanel", "storage"],
  "host_permissions": ["http://127.0.0.1:4100/*", "http://127.0.0.1:9527/*"],
  "background": {"service_worker": "background.js", "type": "module"},
  "action": {"default_title": "Open FitoutAgent"},
  "side_panel": {"default_path": "index.html"},
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; connect-src http://127.0.0.1:4100 http://127.0.0.1:9527"}
}
