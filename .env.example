# Copy to repo root as `.env` — the server auto-loads it on start (does not override shell exports).
PORT=4100
DATA_DIR=.data
# Vite reads apps/extension/.env.local, not this root file.
VITE_AGENT_URL=http://127.0.0.1:4100/agent

# Demo products are opt-in only. Keep 0 to show real retailer results and failures.
ALLOW_MOCK_FALLBACK=0

# --- Live discovery (server-only; never VITE_*) ---
# Walmart Affiliate Marketing API (search/items only — no cart)
# https://walmart.io/apidocs/affiliates/quickstart
WALMART_CONSUMER_ID=
WALMART_KEY_VERSION=
WALMART_PRIVATE_KEY_PEM=
WALMART_PUBLISHER_ID=

# Best Buy Products API (search + affiliate deep links — not session cart verify)
# Fastest path to real product titles/prices for demo: https://developer.bestbuy.com/
BESTBUY_API_KEY=

# Shopify Global Catalog (cross-merchant search — NO store required). Set to 1 for live MVP.
# https://shopify.dev/docs/agents/catalog/global-catalog
SHOPIFY_GLOBAL_CATALOG=1
# Optional override for UCP agent profile URL
# SHOPIFY_UCP_AGENT_PROFILE=https://shopify.dev/ucp/agent-profiles/2026-08-25/valid-with-capabilities.json

# Shopify Storefront API — single-store discovery + REAL cartCreate (only if you own a shop)

# https://shopify.dev/docs/storefronts/headless/building-with-the-storefront-api/cart/manage
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_TOKEN=

# --- Required LLM checklist generation (server-only) ---
# Every goal uses the model; missing credentials or failures surface an error.
AGENT_API_KEY=
# OPENAI_API_KEY is also accepted.
# Responses API-compatible base (default https://api.openai.com/v1)
AGENT_BASE_URL=
# Low-cost model for goal → product types, checklist and optional extras
AGENT_DECOMPOSE_MODEL=gpt-5.6-luna
AGENT_MODEL=

# Future
# AMBIGUOUS_API_KEY=

# Optional fit assessment model; falls back to AGENT_MODEL, then gpt-5.6-luna.
AGENT_FIT_MODEL=
